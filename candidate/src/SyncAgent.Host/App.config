<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Both sections below can be encrypted at rest with DPAPI, without any code change:

        aspnet_regiis -pef "connectionStrings" "<folder containing SyncAgent.Host.exe.config>"
        aspnet_regiis -pef "appSettings"       "<folder containing SyncAgent.Host.exe.config>"

    ConfigurationManager decrypts transparently, and only the account that ran the command can
    read the file. Do that on any machine where the connection string carries a SQL password.

    Alternatively, leave the secrets out of this file entirely and set them in the environment:

        SYNCAGENT_PLATFORM_APIKEY
        SYNCAGENT_CONNECTIONSTRING

    Environment variables take precedence over the values here.
  -->

  <connectionStrings>
    <!--
      Integrated Security by default, so no password exists to leak. Where the agent runs as a
      Windows service the service account is the identity SQL Server sees; sql/01-create-sync-agent-login.sql
      shows how to provision a least-privilege login for the SQL-authentication case instead.

      Encrypt=True asks for an encrypted connection. TrustServerCertificate=True accepts the
      self-signed certificate a default local SQL Server instance ships with — appropriate for
      an agent talking to a database on its own machine, and the setting to remove first when
      the database moves to another host.
    -->
    <add name="AdventureWorks"
         providerName="Microsoft.Data.SqlClient"
         connectionString="Server=.\SQLEXPRESS2025;Database=AdventureWorks2025;Integrated Security=true;Encrypt=True;TrustServerCertificate=True;Connect Timeout=15" />
  </connectionStrings>

  <appSettings>
    <add key="Platform:BaseUrl" value="http://localhost:5100" />

    <!-- The challenge's fixed test key. In a deployment this comes from the environment. -->
    <add key="Platform:ApiKey" value="candidate-test-key-2026" />

    <!-- Cadence. The idle wait doubles from the poll interval up to the backoff ceiling. -->
    <add key="Agent:PollIntervalSeconds" value="5" />
    <add key="Agent:MaxIdleBackoffSeconds" value="60" />

    <!-- Resource ceilings. See SyncAgentOptions for what each one protects against. -->
    <add key="Agent:MaxRecordsPerTask" value="50000" />
    <add key="Agent:MaxResultPayloadBytes" value="33554432" />
    <add key="Agent:SqlCommandTimeoutSeconds" value="30" />
    <add key="Agent:HttpTimeoutSeconds" value="100" />

    <!-- Retry: 4 total attempts, backing off 1s, 2s, 4s with full jitter. -->
    <add key="Agent:MaxRetryAttempts" value="4" />
    <add key="Agent:RetryBaseDelaySeconds" value="1" />

    <!-- Refuses a modifiedSince older than this, which would mean a full table scan. -->
    <add key="Agent:MinModifiedSince" value="2000-01-01T00:00:00Z" />
    <add key="Agent:ClockSkewToleranceSeconds" value="300" />

    <!-- Time allowed after a stop request to report the task already in flight. -->
    <add key="Agent:ShutdownGracePeriodSeconds" value="10" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>

</configuration>
