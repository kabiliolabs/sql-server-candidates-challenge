{
  "ConnectionStrings": {
    "AdventureWorks": "Server=localhost;Database=AdventureWorks2025;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;"
  },

  "SyncPlatform": {
    "BaseUrl": "http://localhost:5100",
    "ApiKey": "candidate-test-key-2026",
    "PollingIntervalMSec": 10000,
    "RequestTimeoutMsec": 30000
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/syncagent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}