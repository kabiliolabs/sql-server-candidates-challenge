<log4net>
  <!--
    PII policy: every log call in this codebase passes only metadata (task type, taskId,
    record counts, durations, HTTP status codes, exception messages) — never row-level data
    (customer names/emails/addresses/etc.), the connection string, or the API key, at any
    level including Debug. This config just formats and routes what the code already keeps
    safe; it doesn't filter anything out, because nothing unsafe should ever reach it. See
    SyncAgent.Core.Tests for a test that guards this at the handler layer.
  -->
  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{HH:mm:ss} [%level] %logger{1} - %message%newline" />
    </layout>
  </appender>

  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="logs/syncagent.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="yyyyMMdd" />
    <maxSizeRollBackups value="14" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss,fff} [%level] %logger - %message%newline" />
    </layout>
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="ConsoleAppender" />
    <appender-ref ref="RollingFileAppender" />
  </root>

  <!-- Polly's own execution-attempt telemetry is useful for debugging retries/circuit-breaker
       trips but noisy for normal operation; keep it out of the default INFO stream. -->
  <logger name="Polly">
    <level value="WARN" />
  </logger>

  <!-- HttpClientFactory's built-in per-request logging (method/URI/status/duration only — no
       body content, so no PII risk) is useful for debugging but noisy for normal operation. -->
  <logger name="System.Net.Http.HttpClient">
    <level value="WARN" />
  </logger>
</log4net>
